# Industrial Automation Knowledge Base - Environment Variables
# Copy this file to .env.local and fill in your values

# NVIDIA Build API (Recommended - uses Nemotron 3 Ultra)
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Alternative: OpenAI API (if not using NVIDIA)
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
NEXT_PUBLIC_APP_NAME=Industrial Automation Knowledge Base
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database (optional - for future persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/automation_kb

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_STREAMING=true
ENABLE_MANUAL_UPLOAD=false
ENABLE_USER_ACCOUNTS=false